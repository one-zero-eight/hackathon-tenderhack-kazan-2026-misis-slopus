# Local credentials excluded from version control.
secrets/
.venv/
__pycache__/
.env
*.pyc
pytest-of-bevzd

# Compressed exports, Parquet catalogs and the data README are versioned.
data/*
!data/*.gz
!data/*.parquet
data/ste-search-dataset.tar.gz
!data/README.md
!data/deprecated/
data/deprecated/*
!data/deprecated/*.gz
!data/tmp/
data/tmp/*
!data/tmp/*.gz
!data/tmp/ste-search-dataset/
data/tmp/ste-search-dataset/*
!data/tmp/ste-search-dataset/*.jsonl.gz
!data/ste-search-dataset/
data/ste-search-dataset/*
!data/ste-search-dataset/*.jsonl.gz

# Export metadata is local state, not a published dataset.
data/**/*.meta.json
data/**/*.meta.json.gz

*.part

# Presentation exports and local browser state.
slides/**/*.pdf
slides/.chromium/
slides/.layout-check.html
