# Optional local embedder: pnpm run meow:start (port 8067).
# Set MEOW_EMBED_URL=http://127.0.0.1:8067 in search-api, not here.
# Set MEOW_EMBED_BIN if meow-embed is installed in a separate virtualenv.

# Primary catalogs (comma-separated). Default: Инструменты, Мебель, Одежда.
# CATEGORY_PARQUETS=../data/Инструменты_from_api.parquet,../data/Мебель_from_api.parquet,../data/Одежда_from_api.parquet
# Optional extra STE dump (unset = not loaded):
# STE_PARQUET=../data/ste.parquet

KTRU_PARQUET=../data/ktru-actual.parquet
# Beautiful tree names / synonyms (optional; falls back to official KTRU names).
MOY_KTRU_PARQUET=../data/moy-zakupki-ktru.parquet
OKPD2_PARQUET=../data/okpd2-moy-zakupki.parquet
# Build: uv run --with pyarrow python scripts/build_classifiers_sqlite.py
CLASSIFIERS_SQLITE=../data/classifiers.sqlite
# Hybrid OKPD2/KTRU/KPGZ/SPGZ search index:
#   cd search-api && uv run zakupki-search-index classifiers [--embed]
# CLASSIFIER_DATABASE=../data/classifier-search.sqlite
SEARCH_DATABASE=./data/search-index.sqlite
# Shared mmap catalog; Python/Node defaults point to the same file.
CATALOG_DATABASE=./data/catalog.sqlite
# Voting/schema assembly and similarity threshold are owned by search-api.
# Configure NEIGHBOR_SCORE_THRESHOLD=0.74 in the Python process environment.
# Server-only FastAPI URL; browsers use SolidStart's /api/search proxy.
SEARCH_API_URL=http://127.0.0.1:8070
