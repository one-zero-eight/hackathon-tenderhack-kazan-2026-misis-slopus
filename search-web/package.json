{
  "name": "zakupki-search",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "meow:start": "tsx scripts/meow.ts",
    "bench:embed": "tsx --env-file-if-exists=.env scripts/bench-embed.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.5",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-solid": "^0.468.0",
    "nitro": "^3.0.260610-beta",
    "nodejs-polars": "^0.26.1",
    "solid-js": "^1.9.16",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
